#!/bin/sh
# Usage: tools/make-golden OUT GITDIR WRITER_BRANCH [GITDIR WRITER_BRANCH]...
# Write OUT, the `golden/run` script of the implementor-golden Graph: for each pair, the Acceptance Writer's change
# (WRITER_BRANCH against its parent, the Task's base) in the bare repository GITDIR, keyed by the base commit.
set -eu
[ $# -ge 3 ] && [ $(($# % 2)) -eq 1 ] || {
	sed -n '2p' "$0" >&2
	exit 2
}
out=$1
shift
{
	cat <<'HEAD'
#!/bin/sh
# GENERATED by tools/make-golden; do not edit.
# The Acceptance Writer replaced by a fixed change: the specs an earlier Acceptance Writer wrote for this base commit,
# recorded as the `acceptance-writer` branch. It runs like Acceptance Test Validation: `cwd` holds the clone `base`;
# the verdict goes to ../out/{result,failed_check,output} and the clone with the specs to ../out/golden.
set -u
out=$(cd .. && pwd)/out
mkdir -p "$out"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*'

red() { # failed_check, message
	echo red >"$out/result"
	printf %s "$1" >"$out/failed_check"
	printf %s "$2" >"$out/output"
	exit 0
}

sha=$(git -C base rev-parse HEAD) || exit 1
case $sha in
HEAD
	while [ $# -gt 0 ]; do
		base=$(git --git-dir "$1" rev-parse "$2^")
		printf '%s)\n\tpatch() {\n\t\tcat <<'"'"'GOLDEN_PATCH_END'"'"'\n' "$base"
		git --git-dir "$1" diff "$base" "$2"
		printf 'GOLDEN_PATCH_END\n\t}\n\t;;\n'
		shift 2
	done
	cat <<'TAIL'
*)
	red no-golden "no golden specs for base commit $sha"
	;;
esac

git clone -q base "$out/golden" || exit 1
git -C "$out/golden" config user.name Golden
git -C "$out/golden" config user.email golden@example.invalid
patch | git -C "$out/golden" apply || red no-golden "the golden specs do not apply to $sha"
git -C "$out/golden" add -A
git -C "$out/golden" commit -q -m "Golden specs"
echo green >"$out/result"
echo "golden specs applied to $sha" >"$out/output"
TAIL
} >"$out"
chmod +x "$out"
