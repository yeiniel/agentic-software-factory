#!/bin/sh
# The Integrator (a pure function from a Run Context to a verdict plus a branch).
#
# Runs with the Context's `cwd` as its working directory. `cwd` holds clones `base`,
# `implementor` and `acceptance-writer`. It writes the verdict to ../out/{result,failed_check,
# output} and, on green, the integrated clone to ../out/integrated. `output` is the
# Acceptance Report or the merge output, verbatim. Exit status is non-zero only when the Integrator
# itself could not run.
set -u
cwd=$(pwd)
out=$(cd .. && pwd)/out
work=$(mktemp -d)
mkdir -p "$out"
# Mounted clones may belong to another user; git config through the environment, not the user's files.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*'

identity() {
	git -C "$1" config user.name Integrator
	git -C "$1" config user.email integrator@example.invalid
}

red() { # failed_check, output file
	echo red >"$out/result"
	printf %s "$1" >"$out/failed_check"
	cp "$2" "$out/output"
	exit 0
}

# 1. Combine the branches on top of the base (which is `main`: Tasks run in sequence). A conflict fails the Run.
git clone -q "$cwd/base" "$out/integrated" || exit 1
identity "$out/integrated"
for role in implementor acceptance-writer; do
	git -C "$out/integrated" fetch -q "$cwd/$role" HEAD || exit 1
	if ! git -C "$out/integrated" merge --no-edit -m "Integrate $role" FETCH_HEAD >"$work/merge" 2>&1; then
		git -C "$out/integrated" merge --abort
		red conflict "$work/merge"
	fi
done

# 2. The entire acceptance suite on the integrated result.
if (cd "$out/integrated" && make test) >"$out/output" 2>&1; then
	echo green >"$out/result"
else
	red suite "$out/output"
fi
