# A shared repository: one container whose main process is git daemon.
# Everyone on the network fetches from and pushes to the repositories in the
# account `git`'s home, git://HOST/NAME.git (a closed network: the network is
# the identity). A push can't rewrite or delete history, and every push to
# main is checked: `make check` on a fresh checkout, the verdict mailed to the
# addresses in ~/notify. The account's home is meant to be a volume.
# Configuration is in rootfs/, at its place in the image.
# Build: podman build -t asf-repo images/repo/
FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git make s-nail \
 && rm -rf /var/lib/apt/lists/*

COPY rootfs/ /

RUN useradd -m -u 1000 -c git -s /bin/bash git
# git daemon starts as root and drops to `git`, and keeps this HOME.
ENV HOME=/home/git

EXPOSE 9418
CMD ["git", "daemon", "--reuseaddr", "--verbose", "--base-path=/home/git", "--export-all", \
     "--enable=receive-pack", "--user=git", "--group=git"]
