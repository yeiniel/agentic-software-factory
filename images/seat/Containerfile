# A person's seat: a mail host with their account, `user` (uid 1000), whose
# home is meant to be a volume. They log in with a login shell (bash -l),
# where `mail` reads their ~/Maildir. The node's name says who they are:
# user@NAME.DOMAIN.
# Build: podman build -t asf-seat images/seat/   (after asf-mail)
FROM localhost/asf-mail

# git, for the work shared in repositories.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

# Its full name is what git writes as the author; the host makes the address.
RUN useradd -m -u 1000 -c user -s /bin/bash user
