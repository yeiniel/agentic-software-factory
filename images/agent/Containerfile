# An agent: a mail host whose account `agent` hands each mail to pi, one at
# a time, all in one conversation (~/sessions); each mail is also kept in
# ~/Maildir. The model server is the node's own: ~/.pi/agent/models.json.
# Configuration is in rootfs/, at its place in the image; what the account's
# home starts with is in home/.
# Build: podman build -t asf-agent images/agent/   (after asf-mail)
FROM docker.io/library/node:24-trixie-slim AS pi
RUN npm install -g --prefix /opt/pi @earendil-works/pi-coding-agent@0.87.1

FROM localhost/asf-mail

# pi, with the Node.js it runs on.
COPY --from=pi /usr/local/bin/node /usr/local/bin/node
COPY --from=pi /opt/pi /opt/pi
RUN ln -s /opt/pi/bin/pi /usr/local/bin/pi

COPY rootfs/ /

RUN useradd -m -u 1000 -s /bin/bash agent
COPY --chown=agent:agent home/ /home/agent/
