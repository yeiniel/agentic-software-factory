# The agent harness layer: Pi and its runtime (role skills come with the Run Context) on top of the repo's own image (built as BASE).
# Pi needs Node >= 22.19, newer than some distributions package: apt and dnf bases get Node from the
# official tarball; apk bases use their own package and are checked.
ARG BASE
FROM ${BASE}
ARG NODE_VERSION=22.19.0
# POSIX sh across the apk, apt and dnf bases: there is no pipefail to set.
# hadolint ignore=DL4006
RUN set -e; \
    if command -v apk > /dev/null; then apk add --no-cache nodejs npm bash ripgrep; \
    elif command -v apt-get > /dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends curl xz-utils ca-certificates ripgrep \
        && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf > /dev/null; then dnf install -y curl xz ripgrep && dnf clean all; \
    else echo "no supported package manager (apk, apt-get, dnf) to install Pi's runtime" >&2; exit 1; fi; \
    if ! command -v apk > /dev/null; then \
        case "$(uname -m)" in x86_64) arch=x64;; aarch64) arch=arm64;; *) echo "unsupported architecture" >&2; exit 1;; esac; \
        curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" \
            | tar -xJ -C /usr/local --strip-components=1; \
    fi; \
    node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a==22&&b>=19)?0:1)' \
        || { echo "Pi needs Node >= 22.19, found $(node --version)" >&2; exit 1; }
ARG PI_VERSION=1.3.0
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}
COPY entrypoint.sh /opt/asf/entrypoint.sh
ENV PI_OFFLINE=1 PI_TELEMETRY=0
ENTRYPOINT ["/opt/asf/entrypoint.sh"]
