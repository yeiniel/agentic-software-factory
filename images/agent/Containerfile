# The agent harness layer: Pi and its runtime on top of the repo's own image (built as BASE).
ARG BASE
FROM ${BASE}
RUN set -e; \
    if command -v apk > /dev/null; then apk add --no-cache nodejs npm bash ripgrep; \
    elif command -v apt-get > /dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates ripgrep \
        && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf > /dev/null; then dnf install -y nodejs npm ripgrep && dnf clean all; \
    else echo "no supported package manager (apk, apt-get, dnf) to install Pi's runtime" >&2; exit 1; fi
ARG PI_VERSION=1.3.0
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}
COPY skills /root/.pi/agent/skills
COPY entrypoint.sh /opt/asf/entrypoint.sh
ENV PI_OFFLINE=1 PI_TELEMETRY=0
ENTRYPOINT ["/opt/asf/entrypoint.sh"]
