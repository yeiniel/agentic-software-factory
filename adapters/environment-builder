#!/usr/bin/env python3
"""Environment Builder Adapter: Podman builds of the repo's Containerfile plus our tooling layers.

  build --repo R --commit C --purpose agent|integrator   ->   {"image"}

The repo's own `Containerfile` (at its root, at commit C) is built first and must provide `git` and `make`.
The layer for the purpose (images/<purpose>/ or $ASF_IMAGES_DIR/<purpose>/) is built on top. Images
are tagged by repo and commit (and the layer's content), and an existing image is reused.

$ASF_BUILD_SECCOMP_PROFILE, if set, is the seccomp profile for build steps (a Podman client in a container
sends its own default path, which the host's Podman may not have).
"""
import hashlib
import os
import tempfile
from pathlib import Path

import _common
from _common import Failure, git, podman, remote, slug

PURPOSES = ("agent", "integrator")


def layer_dir(purpose):
    root = os.environ.get("ASF_IMAGES_DIR") or Path(__file__).resolve().parent.parent / "images"
    return Path(root) / purpose


def digest(directory):
    """Short hash of a directory's files, so changed tooling means a new image."""
    h = hashlib.sha256()
    for path in sorted(p for p in directory.rglob("*") if p.is_file()):
        h.update(str(path.relative_to(directory)).encode() + path.read_bytes())
    return h.hexdigest()[:8]


def build_args():
    profile = os.environ.get("ASF_BUILD_SECCOMP_PROFILE")
    return ["--security-opt", f"seccomp={profile}"] if profile else []


def exists(tag):
    return podman("image", "exists", tag, check=False).returncode == 0


def fetch_source(repo, commit, dest):
    git("init", "-q", dest)
    if git("fetch", "-q", "--depth=1", remote(repo), commit, cwd=dest, check=False) is None:
        git("fetch", "-q", remote(repo), "+refs/heads/*:refs/remotes/origin/*", cwd=dest)
    git("checkout", "-q", commit, cwd=dest)


def build_base(repo, commit, tag):
    with tempfile.TemporaryDirectory() as src:
        fetch_source(repo, commit, src)
        if not (Path(src) / "Containerfile").is_file():
            raise Failure(f"{repo} at {commit} has no Containerfile at its root")
        podman("build", "-q", *build_args(), "-t", tag, "-f", "Containerfile", src)
    probe = podman("run", "--rm", "--entrypoint", "sh", tag, "-c",
                   "command -v git > /dev/null || exit 3; command -v make > /dev/null || exit 4",
                   check=False)
    if probe.returncode:
        podman("rmi", "-f", tag, check=False)
        missing = {3: "git", 4: "make"}.get(probe.returncode)
        raise Failure(f"the image built from {repo}'s Containerfile at {commit} "
                      + (f"lacks `{missing}`" if missing else f"cannot run `sh`: {probe.stderr.strip()}")
                      + "; it must provide git and make")


def build(a):
    repo, commit, purpose = a["repo"], a["commit"], a["purpose"]
    if purpose not in PURPOSES:
        raise Failure(f"unknown purpose {purpose!r}")
    short = f"{slug(repo)}:{commit[:12]}"
    base = f"localhost/asf-base-{short}"
    if not exists(base):
        build_base(repo, commit, base)
    layer = layer_dir(purpose)
    tag = f"localhost/asf-{purpose}-{slug(repo)}:{commit[:12]}-{digest(layer)}"
    if not exists(tag):
        podman("build", "-q", *build_args(), "--build-arg", f"BASE={base}", "-t", tag, str(layer))
    return {"image": tag}


if __name__ == "__main__":
    _common.main({"build": build})
