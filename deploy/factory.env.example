# Copied to ~/.config/asf/factory.env by deploy/install; edit to taste, then restart the factory unit.
# The model server (bin/model) listens on the host; Agents reach it only through the model relay (container
# `model-relay`), because the asf-agents network is internal.
ASF_MODEL_ENDPOINT=http://model-relay:8080/v1
ASF_MODEL_NAME=ornith-1.5-35b
ASF_MODEL_CONTEXT_WINDOW=49152
# The Console's receiver (container `console` on asf-net). Without a reachable receiver every Task is
# blocked with reason `infrastructure`; to run without the Console point deploy/config.json at adapters/records.
OTEL_EXPORTER_OTLP_ENDPOINT=http://console:4318
