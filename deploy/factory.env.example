# Copied to ~/.config/asf/factory.env by deploy/install; edit to taste, then restart the factory unit.
# The model server (bin/model) listens on the host; Agents reach it over the asf-agents network.
ASF_MODEL_ENDPOINT=http://host.containers.internal:8080/v1
ASF_MODEL_NAME=qwen3-coder-next
ASF_MODEL_CONTEXT_WINDOW=49152
