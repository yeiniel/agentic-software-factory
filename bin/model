#!/bin/sh
# Usage: bin/model [stop]
# Start the model server the agents talk to (port 8080, two slots of
# 49,152 tokens each, one per role), as a user unit named llama-server, with /metrics for the Console;
# `stop` stops it.
set -eu
if [ "${1:-}" = stop ]; then
	systemctl --user stop llama-server.service && echo "down: llama-server"
	exit
fi
systemd-run --user --unit=llama-server /usr/bin/llama-server \
	-m "$HOME/.lmstudio/models/ornith-ai/Ornith-1.5-35B-A3B-GGUF/Ornith-1.5-35B-Q4_K_M.gguf" \
	-a ornith-1.5-35b -c 98304 -np 2 -t 20 --fit on -fitt 256 -ub 2048 -fa on --jinja \
	--cache-type-k q8_0 --cache-type-v q8_0 \
	--cache-ram 24576 --metrics --host 0.0.0.0 --port 8080 && echo "up: llama-server"
