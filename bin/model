#!/bin/sh
# Usage: bin/model [stop]
# Start the model server the agents talk to (port 8080, three slots of
# 98,304 tokens each, one per role), as a user unit named llama-server;
# `stop` stops it.
set -eu
if [ "${1:-}" = stop ]; then systemctl --user stop llama-server.service && echo "down: llama-server"; exit; fi
systemd-run --user --unit=llama-server /usr/bin/llama-server \
  -m "$HOME/.lmstudio/models/bartowski/cerebras_Qwen3-Coder-REAP-25B-A3B-GGUF/cerebras_Qwen3-Coder-REAP-25B-A3B-Q6_K.gguf" \
  -a qwen3-coder-reap-25b -c 294912 -np 3 -t 10 --fit on -fa on --jinja \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --cache-ram 24576 --host 0.0.0.0 --port 8080 && echo "up: llama-server"
